 static uint32_t sweet_fb_swaps_logged;
 static uint64_t sweet_fb_swap_count;
 
+/*
+ * surya measurements (boot-arg suryastat=1, read by bsd/dev/sweet_touch.c):
+ * swaps, swaps whose first layer looks like the previous one (32 rows x 32
+ * pixels sampled), panel copies with their time, vsync ticks, and where the
+ * panel memory is for the copy speed test.
+ */
+extern "C" {
+int sweet_fb_stat_on;
+uint64_t sweet_fb_stat_swaps, sweet_fb_stat_dups, sweet_fb_stat_copies;
+uint64_t sweet_fb_stat_copy_ns, sweet_fb_stat_copy_max_ns, sweet_fb_stat_ticks;
+uintptr_t sweet_fb_stat_pixels;
+uint32_t sweet_fb_stat_rowbytes, sweet_fb_stat_width, sweet_fb_stat_height;
+}
+static uint64_t sweet_fb_stat_last_hash;
+
+static void
+sweet_fb_stat_swap(const uint8_t *rec)
+{
+	uint32_t id = get32(rec, 0x54);
+	SweetSurface *s = id ? sweet_surface_copy(id) : NULL;
+	if (s == NULL) {
+		return;
+	}
+	uint64_t hash = 0;
+	uintptr_t base = s->kernelAddress();
+	if (base != 0 && s->memory != NULL && s->bytesPerRow >= s->width * 4 &&
+	    (uint64_t)s->offset + (uint64_t)s->height * s->bytesPerRow <= s->memory->getLength() &&
+	    s->height >= 32 && s->width >= 32) {
+		for (uint32_t i = 0; i < 32; i++) {
+			const uint32_t *row = (const uint32_t *)(base + s->offset +
+			    (uint64_t)(i * (s->height / 32)) * s->bytesPerRow);
+			for (uint32_t j = 0; j < 32; j++) {
+				hash = hash * 1000003ULL + row[j * (s->width / 32)];
+			}
+		}
+	}
+	s->release();
+	sweet_fb_stat_swaps++;
+	if (hash == sweet_fb_stat_last_hash) {
+		sweet_fb_stat_dups++;
+	}
+	sweet_fb_stat_last_hash = hash;
+}
+
 /* Copy each enabled layer's surface into the panel memory (no scaling). */
 /*
  * A swap only records the frame: copying 10 MB into the panel on every
