+/* surya mode: copies the latest frame whenever the vsync timer asks. */
+void
+AppleCLCD::copyLoop(void)
+{
+	bool cache_reset = !surya_fb_2x;
+	for (;;) {
+		if (!cache_reset) {
+			int err = surya_fb2x_reset_cache();
+			if (err != EAGAIN) {
+				cache_reset = true;
+				IOLog("SWEET FB: @2x: MobileGestalt cache truncated (err %d)\n", err);
+			}
+		}
+		IOLockLock(fLock);
+		while (!fCopyWanted) {
+			(void)IOLockSleep(fLock, &fCopyWanted, THREAD_UNINT);
+		}
+		fCopyWanted = false;
+		memcpy(fCopyRec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		IOLockUnlock(fLock);
+		present(fCopyRec);
+		IOLockLock(fLock);
+		IOLockWakeup(fLock, &fDirty, false); /* SwapWait: the frame is on the panel */
+		IOLockUnlock(fLock);
+	}
+}
+
+static void
+surya_fb_copy_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	((AppleCLCD *)arg)->copyLoop();
+}
+
+/* surya mode SwapWait: until the pending frame has been copied, at most 50 ms. */
+void
+AppleCLCD::swapWait(void)
+{
+	uint64_t deadline = mach_absolute_time() + 3 * fVsyncPeriod;
+	IOLockLock(fLock);
+	while (fDirty && !fPowerOff && mach_absolute_time() < deadline) {
+		(void)IOLockSleepDeadline(fLock, &fDirty, deadline, THREAD_UNINT);
+	}
+	IOLockUnlock(fLock);
 }
 
