+	uint8_t id[6], mask[6];
+	const char *name;
+} surya_ids[] = {
+	{{0x0c, 0xff, 0xff, 0x72, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36675"},
+	{{0xff, 0xff, 0xff, 0x26, 0x65, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36526"},
+	{{0xff, 0xff, 0xff, 0x75, 0x66, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36675"},
+	{{0x0b, 0xff, 0xff, 0x72, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0b, 0xff, 0xff, 0x82, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0b, 0xff, 0xff, 0x25, 0x65, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x72, 0x65, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x72, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x82, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x70, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0b, 0xff, 0xff, 0x70, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x72, 0x67, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x55, 0x00, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0x55, 0x72, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0xaa, 0x00, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0xaa, 0x72, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x72, 0x67, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x70, 0x66, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x70, 0x67, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x72, 0x66, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+};
+
+static void
+surya_pin(vm_offset_t tile, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(tile, off);
+	if (out) {
+		touch_wr(tile, TOUCH_GPIO_IO(pin),
+		    (touch_rd(tile, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(tile, off, cfg);
+}
+
+static bool
+surya_clocks(void)
+{
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | SURYA_VOTE_MASK);
+	uint32_t dfs = touch_rd(st.gcc, SURYA_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, SURYA_RCG + 4u);
+	printf("SURYA TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, SURYA_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = touch_rd(st.gcc, SURYA_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SURYA TOUCH: DFS level0=%#x is not XO/1; need clock integration\n", cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, SURYA_RCG + 4u, cfg);
+		touch_wr(st.gcc, SURYA_RCG, touch_rd(st.gcc, SURYA_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, SURYA_RCG, 1u)) {
+			printf("SURYA TOUCH: RCG update timeout\n");
+			return false;
+		}
+	}
+	/* gcc-sdmmagpie.c halt registers: m_ahb, s_ahb, core, core_2x, S0. */
+	const uint32_t branches[] = {0x17004, 0x17008, 0x1700c, 0x17014, 0x17030};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("SURYA TOUCH: GCC branch %#x halted (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+surya_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("SURYA TOUCH: se0 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx);
+	/* Protocol 1 = SPI (qcom-geni-se.h); SE firmware comes from qupfw. */
+	if (((fw >> 8) & 0xffu) != 1u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SURYA TOUCH: need SPI firmware on SE0 and 32-bit FIFOs; stopping\n");
+		return false;
+	}
+	sy.depth = (tx >> 16) & 0x3fu;
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SURYA TOUCH: SE0 already busy; stopping\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	/* spi-geni-qcom.c setup_fifo_params: CS0, mode 0, no loopback, no delays. */
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (4u << 4) | 1u); /* 19.2 MHz / 4 = 4.8 MHz */
+	touch_wr(st.se, SPI_LOOPBACK_REG, 0);
+	touch_wr(st.se, SPI_DEMUX_SEL, 0);
+	touch_wr(st.se, SPI_CPHA_REG, 0);
+	touch_wr(st.se, SPI_CPOL_REG, 0);
+	touch_wr(st.se, SPI_DEMUX_INV, 0);
+	touch_wr(st.se, SPI_DELAYS, 0);
+	touch_wr(st.se, SPI_WORD_LEN, (touch_rd(st.se, SPI_WORD_LEN) & ~0x3ffu) | (8u - 4u));
+	touch_wr(st.se, SPI_TRANS_CFG, touch_rd(st.se, SPI_TRANS_CFG) & ~1u); /* no CS toggle */
+	/* 8-bit words, four per FIFO word, MSB first: the packing sweet verified. */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    (touch_rd(st.se, SPI_WORD_LEN) & 0x3ffu) != 4u) {
+		printf("SURYA TOUCH: SPI config readback mismatch; stopping\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SURYA TOUCH: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+surya_drain(uint8_t *rx, unsigned len, unsigned *got)
+{
+	uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+	for (unsigned i = 0; i < count && i < 64; ++i) {
+		uint32_t word = touch_rd(st.se, SE_RX);
+		for (unsigned j = 0; j < 4 && rx && *got < len; ++j) {
+			rx[(*got)++] = (uint8_t)(word >> (8u * j));
+		}
+	}
+}
+
+/* One FIFO-mode SPI transfer: TX only, or full duplex of len bytes. */
+static int
+surya_spi(unsigned op, const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	unsigned sent = 0, got = 0;
+	if (st.dead || !len || len > SURYA_SPI_MAX || (op == SPI_OP_FULL && !rx)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE0 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SPI_TX_LEN, len);
+	touch_wr(st.se, SPI_RX_LEN, op == SPI_OP_FULL ? len : 0u);
+	touch_wr(st.se, SE_CMD, op << 27); /* no FRAGMENTATION: CS drops at the end */
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SE_ERRORS) {
+			printf("SURYA TOUCH: spi op=%u len=%u error irq=%#x\n", op, len, irq);
+			break;
+		}
+		while (sent < len && (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) < sy.depth) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && sent < len; ++j, ++sent) {
+				word |= (uint32_t)(tx ? tx[sent] : 0u) << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+		}
+		surya_drain(rx, op == SPI_OP_FULL ? len : 0u, &got);
+		if (irq & SE_DONE) {
+			surya_drain(rx, op == SPI_OP_FULL ? len : 0u, &got);
+			touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+			if (sent == len && (op != SPI_OP_FULL || got == len)) {
+				return 0;
+			}
+			printf("SURYA TOUCH: spi op=%u len=%u short sent=%u got=%u\n", op, len, sent, got);
+			return EIO;
+		}
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return ETIMEDOUT;
+}
+
+/* nt36xxx.c CTP_SPI_WRITE: first byte | 0x80, TX only. */
+static int
+surya_nvt_write(const uint8_t *buf, unsigned len)
+{
+	if (len > SURYA_SPI_MAX) {
+		return EIO;
+	}
+	memcpy(sy.tx, buf, len);
+	sy.tx[0] |= 0x80u;
+	return surya_spi(SPI_OP_TX, sy.tx, NULL, len);
+}
+
+/* nt36xxx.c CTP_SPI_READ: first byte & 0x7f, len + 1 bytes full duplex,
+ * data from the third received byte on goes to buf[1..len-1]. */
+static int
+surya_nvt_read(uint8_t *buf, unsigned len)
+{
+	if (len < 2 || len + 1u > SURYA_SPI_MAX) {
+		return EIO;
+	}
+	memset(sy.tx, 0, len + 1u);
+	memcpy(sy.tx, buf, len);
+	sy.tx[0] &= 0x7fu;
+	int err = surya_spi(SPI_OP_FULL, sy.tx, sy.rx, len + 1u);
+	if (!err) {
+		memcpy(buf + 1, sy.rx + 2, len - 1u);
+	}
+	return err;
+}
+
+static int
+surya_nvt_page(uint32_t addr)
+{
+	const uint8_t buf[3] = {0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7)};
+	return surya_nvt_write(buf, sizeof(buf));
+}
+
+static int
+surya_nvt_write_addr(uint32_t addr, uint8_t data)
+{
+	int err = surya_nvt_page(addr);
+	if (err) {
+		return err;
+	}
+	const uint8_t buf[2] = {(uint8_t)(addr & 0x7fu), data};
+	return surya_nvt_write(buf, sizeof(buf));
+}
+
+/* nt36xxx.c nvt_bootloader_reset + nvt_ts_check_chip_ver_trim. */
+static int
+surya_nvt_chip_id(uint8_t id[6])
+{
+	int err = surya_nvt_write_addr(NVT_SWRST_N8, 0x69);
+	if (err) {
+		return err;
+	}
+	touch_wait(5); /* tBRST2FR after bootloader reset */
+	err = surya_nvt_write_addr(NVT_RD_FAST, 0x00);
+	if (err) {
+		return err;
+	}
+	err = surya_nvt_page(NVT_CHIP_ID);
+	if (err) {
+		return err;
+	}
+	uint8_t buf[8] = {(uint8_t)(NVT_CHIP_ID & 0x7fu)};
+	err = surya_nvt_read(buf, 7);
+	if (!err) {
+		memcpy(id, buf + 1, 6);
+	}
+	return err;
+}
+
+static const char *
+surya_chip_name(const uint8_t id[6])
+{
+	for (unsigned k = 0; k < sizeof(surya_ids) / sizeof(surya_ids[0]); ++k) {
+		unsigned i;
+		for (i = 0; i < 6; ++i) {
+			if (surya_ids[k].mask[i] && id[i] != surya_ids[k].id[i]) {
+				break;
+			}
+		}
+		if (i == 6) {
+			return surya_ids[k].name;
+		}
+	}
+	return NULL;
+}
+
+static void
+surya_touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SURYA TOUCH: Novatek SPI milestone 1 (chip id) in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("SURYA TOUCH: mapping GCC/TLMM/SE0\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	sy.west = ml_io_map(SURYA_WEST_PA, 0x35000);
+	st.se = ml_io_map(SURYA_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !sy.west || !st.se) {
+		printf("SURYA TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SURYA TOUCH: before: spi cfg %#x %#x %#x %#x rst cfg=%#x io=%#x irq cfg=%#x io=%#x\n",
+	    touch_rd(sy.west, TOUCH_GPIO_CFG(49)), touch_rd(sy.west, TOUCH_GPIO_CFG(50)),
+	    touch_rd(sy.west, TOUCH_GPIO_CFG(51)), touch_rd(sy.west, TOUCH_GPIO_CFG(52)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(SURYA_RST_GPIO)), touch_rd(st.gpio, TOUCH_GPIO_IO(SURYA_RST_GPIO)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(SURYA_IRQ_GPIO)), touch_rd(st.gpio, TOUCH_GPIO_IO(SURYA_IRQ_GPIO)));
+	if (!surya_clocks() || !surya_se_init()) {
+		goto out;
+	}
+	for (unsigned pin = 49; pin <= 52; ++pin) {
+		surya_pin(sy.west, pin, 2, 0, 2, false, false); /* qup00, no pull, 6 mA */
+	}
+	/* Linux probe: reset requested low, then high, 10 ms after power-on reset. */
+	surya_pin(st.gpio, SURYA_RST_GPIO, 0, 0, 0, true, false);
+	touch_wait(5);
+	surya_pin(st.gpio, SURYA_RST_GPIO, 0, 0, 0, true, true);
+	touch_wait(20);
+	uint8_t id[6] = {0};
+	int err = EIO;
+	for (unsigned retry = 0; retry < 5 && !st.dead; ++retry) {
+		err = surya_nvt_chip_id(id);
+		printf("SURYA TOUCH: chip id try %u err=%d id=%02x %02x %02x %02x %02x %02x irq=%#x\n",
+		    retry, err, id[0], id[1], id[2], id[3], id[4], id[5], st.irq_status);
+		if (!err && surya_chip_name(id)) {
+			break;
+		}
+		touch_wait(10);
+	}
+	const char *name = err ? NULL : surya_chip_name(id);
+	printf("SURYA TOUCH: milestone 1 %s: %s\n", name ? "PASSED" : "FAILED",
+	    name ? name : "no Novatek id");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
