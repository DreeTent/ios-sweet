surya: Novatek NT36672C over GENI SE0 SPI, milestones 1-2

sweettouch=2 selects it. Milestone 1: clocks, pins, SPI, bootloader reset,
chip id. Milestone 2: firmware download with the chip's hardware CRC, as
Xiaomi's nvt_download_firmware_hw_crc. The firmware itself is Xiaomi's and is
not in this tree: the locally built ADT carries it as /surya-touch "firmware".
No touch reports yet.

--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -14,6 +14,7 @@
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 /* Mach MIG declaration is not included by BSD's exported thread.h. */
@@ -635,6 +636,717 @@
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * surya (Poco X3 NFC), sweettouch=2: Novatek NT36672C TDDI on GENI SE0 in
+ * SPI mode (qupv3_se0_spi, 0x880000), CS0, SPI mode 0, 8-bit words, <= 8 MHz.
+ * Facts from surya's dtbo (fragment 62) and Xiaomi surya-q-oss nt36xxx_spi:
+ *  - SPI pins gpio49-52, function qup00 (2nd), WEST tile; ABL leaves them as
+ *    plain GPIOs, so they are muxed here (6 mA, no pull, as the DT active state).
+ *  - Touch reset TLMM gpio8, interrupt TLMM gpio9 (NORTH tile). The panel reset
+ *    is PM6150L GPIO 9, a different chip: gpio8 resets only the touch MCU.
+ *  - Power is shared with the panel (lab/ibb, L18A): nothing is voted here.
+ *    L11C, which the sweet driver votes, feeds the Wi-Fi RF on surya.
+ * Milestone 1: clocks, pins, SPI, bootloader reset, chip id read.
+ * Milestone 2: firmware download with the chip's hardware CRC
+ * (nvt_download_firmware_hw_crc, hw_crc = 2). The NT36672C keeps no firmware;
+ * Xiaomi's novatek_ts_huaxing_fw.bin is not redistributable, so it is not in
+ * this tree: a locally built ADT carries it as /surya-touch "firmware".
+ * No touch reports yet.
+ */
+#define SURYA_SE_PA      0x00880000u
+#define SURYA_WEST_PA    0x03500000u /* DT TLMM + WEST (0x100000) */
+#define SURYA_RCG        0x17034u    /* wrapper0 S0 */
+#define SURYA_VOTE_MASK  (0x1fu << 6) /* wrap0 m_ahb, s_ahb, core, core_2x, S0 */
+#define SURYA_RST_GPIO   8u
+#define SURYA_IRQ_GPIO   9u
+#define SURYA_SPI_MAX    64u
+
+#define SPI_CPHA_REG     0x224u
+#define SPI_LOOPBACK_REG 0x22cu
+#define SPI_CPOL_REG     0x230u
+#define SPI_DEMUX_INV    0x24cu
+#define SPI_DEMUX_SEL    0x250u
+#define SPI_TRANS_CFG    0x25cu
+#define SPI_WORD_LEN     0x268u
+#define SPI_TX_LEN       0x26cu
+#define SPI_RX_LEN       0x270u
+#define SPI_DELAYS       0x278u
+#define SPI_OP_TX        1u
+#define SPI_OP_FULL      3u
+
+#define NVT_SWRST_N8     0x3f0feu /* novatek,swrst-n8-addr */
+#define NVT_RD_FAST      0x3f310u /* novatek,spi-rd-fast-addr */
+#define NVT_CHIP_ID      0x1f64eu
+
+/* NT36675_memory_map, the map Xiaomi uses for id 0c xx xx 72 66 03. */
+#define NVT_EVENT_BUF    0x22d00u
+#define NVT_EV_HOST_CMD  0x50u
+#define NVT_EV_RESET     0x60u
+#define NVT_EV_FWINFO    0x78u
+#define NVT_EV_PID       0x9au
+#define NVT_BOOT_RDY     0x3f10du
+#define NVT_ILM_LENGTH   0x3f118u
+#define NVT_DLM_LENGTH   0x3f130u
+#define NVT_ILM_DES      0x3f128u
+#define NVT_DLM_DES      0x3f12cu
+#define NVT_G_ILM_CHK    0x3f100u
+#define NVT_G_DLM_CHK    0x3f104u
+#define NVT_R_ILM_CHK    0x3f120u
+#define NVT_R_DLM_CHK    0x3f124u
+#define NVT_BLD_CRC_EN   0x3f30eu
+#define NVT_BLD_CRC_FLAG 0x3f133u
+#define NVT_FW_CHUNK     4096u
+#define NVT_FW_PARTS     32u
+
+static struct {
+	vm_offset_t west;
+	unsigned depth;
+	uint8_t tx[SURYA_SPI_MAX], rx[SURYA_SPI_MAX];
+	uint8_t big[1 + NVT_FW_CHUNK];
+} sy;
+
+/* nvt_ts_bin_map: where each firmware piece lies in the file and in SRAM. */
+static struct {
+	uint32_t bin, sram, size, crc;
+} nvt_parts[NVT_FW_PARTS];
+static unsigned nvt_nparts, nvt_fw_ver;
+
+/* Xiaomi trim_id_table, nt36xxx_mem_map.h: byte compared where mask is 1. */
+static const struct {
+	uint8_t id[6], mask[6];
+	const char *name;
+} surya_ids[] = {
+	{{0x0c, 0xff, 0xff, 0x72, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36675"},
+	{{0xff, 0xff, 0xff, 0x26, 0x65, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36526"},
+	{{0xff, 0xff, 0xff, 0x75, 0x66, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36675"},
+	{{0x0b, 0xff, 0xff, 0x72, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0b, 0xff, 0xff, 0x82, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0b, 0xff, 0xff, 0x25, 0x65, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x72, 0x65, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x72, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x82, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x70, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0b, 0xff, 0xff, 0x70, 0x66, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x0a, 0xff, 0xff, 0x72, 0x67, 0x03}, {1, 0, 0, 1, 1, 1}, "NT36672A"},
+	{{0x55, 0x00, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0x55, 0x72, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0xaa, 0x00, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0xaa, 0x72, 0xff, 0x00, 0x00, 0x00}, {1, 1, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x72, 0x67, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x70, 0x66, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x70, 0x67, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+	{{0xff, 0xff, 0xff, 0x72, 0x66, 0x03}, {0, 0, 0, 1, 1, 1}, "NT36772"},
+};
+
+static void
+surya_pin(vm_offset_t tile, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(tile, off);
+	if (out) {
+		touch_wr(tile, TOUCH_GPIO_IO(pin),
+		    (touch_rd(tile, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(tile, off, cfg);
+}
+
+static bool
+surya_clocks(void)
+{
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | SURYA_VOTE_MASK);
+	uint32_t dfs = touch_rd(st.gcc, SURYA_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, SURYA_RCG + 4u);
+	printf("SURYA TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, SURYA_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = touch_rd(st.gcc, SURYA_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SURYA TOUCH: DFS level0=%#x is not XO/1; need clock integration\n", cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, SURYA_RCG + 4u, cfg);
+		touch_wr(st.gcc, SURYA_RCG, touch_rd(st.gcc, SURYA_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, SURYA_RCG, 1u)) {
+			printf("SURYA TOUCH: RCG update timeout\n");
+			return false;
+		}
+	}
+	/* gcc-sdmmagpie.c halt registers: m_ahb, s_ahb, core, core_2x, S0. */
+	const uint32_t branches[] = {0x17004, 0x17008, 0x1700c, 0x17014, 0x17030};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("SURYA TOUCH: GCC branch %#x halted (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+surya_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("SURYA TOUCH: se0 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx);
+	/* Protocol 1 = SPI (qcom-geni-se.h); SE firmware comes from qupfw. */
+	if (((fw >> 8) & 0xffu) != 1u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SURYA TOUCH: need SPI firmware on SE0 and 32-bit FIFOs; stopping\n");
+		return false;
+	}
+	sy.depth = (tx >> 16) & 0x3fu;
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SURYA TOUCH: SE0 already busy; stopping\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	/* spi-geni-qcom.c setup_fifo_params: CS0, mode 0, no loopback, no delays. */
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (4u << 4) | 1u); /* 19.2 MHz / 4 = 4.8 MHz */
+	touch_wr(st.se, SPI_LOOPBACK_REG, 0);
+	touch_wr(st.se, SPI_DEMUX_SEL, 0);
+	touch_wr(st.se, SPI_CPHA_REG, 0);
+	touch_wr(st.se, SPI_CPOL_REG, 0);
+	touch_wr(st.se, SPI_DEMUX_INV, 0);
+	touch_wr(st.se, SPI_DELAYS, 0);
+	touch_wr(st.se, SPI_WORD_LEN, (touch_rd(st.se, SPI_WORD_LEN) & ~0x3ffu) | (8u - 4u));
+	touch_wr(st.se, SPI_TRANS_CFG, touch_rd(st.se, SPI_TRANS_CFG) & ~1u); /* no CS toggle */
+	/* 8-bit words, four per FIFO word, MSB first: the packing sweet verified. */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    (touch_rd(st.se, SPI_WORD_LEN) & 0x3ffu) != 4u) {
+		printf("SURYA TOUCH: SPI config readback mismatch; stopping\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SURYA TOUCH: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+surya_drain(uint8_t *rx, unsigned len, unsigned *got)
+{
+	uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+	for (unsigned i = 0; i < count && i < 64; ++i) {
+		uint32_t word = touch_rd(st.se, SE_RX);
+		for (unsigned j = 0; j < 4 && rx && *got < len; ++j) {
+			rx[(*got)++] = (uint8_t)(word >> (8u * j));
+		}
+	}
+}
+
+/* One FIFO-mode SPI transfer: TX only, or full duplex of len bytes. */
+static int
+surya_spi(unsigned op, const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	unsigned sent = 0, got = 0;
+	if (st.dead || !len || len > sizeof(sy.big) || (op == SPI_OP_FULL && (!rx || len > SURYA_SPI_MAX))) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE0 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SPI_TX_LEN, len);
+	touch_wr(st.se, SPI_RX_LEN, op == SPI_OP_FULL ? len : 0u);
+	touch_wr(st.se, SE_CMD, op << 27); /* no FRAGMENTATION: CS drops at the end */
+	for (unsigned i = 0; i < 20000u + 8u * len; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SE_ERRORS) {
+			printf("SURYA TOUCH: spi op=%u len=%u error irq=%#x\n", op, len, irq);
+			break;
+		}
+		while (sent < len && (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) < sy.depth) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && sent < len; ++j, ++sent) {
+				word |= (uint32_t)(tx ? tx[sent] : 0u) << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+		}
+		surya_drain(rx, op == SPI_OP_FULL ? len : 0u, &got);
+		if (irq & SE_DONE) {
+			surya_drain(rx, op == SPI_OP_FULL ? len : 0u, &got);
+			touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+			if (sent == len && (op != SPI_OP_FULL || got == len)) {
+				return 0;
+			}
+			printf("SURYA TOUCH: spi op=%u len=%u short sent=%u got=%u\n", op, len, sent, got);
+			return EIO;
+		}
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return ETIMEDOUT;
+}
+
+/* nt36xxx.c CTP_SPI_WRITE: first byte | 0x80, TX only. */
+static int
+surya_nvt_write(const uint8_t *buf, unsigned len)
+{
+	if (len > SURYA_SPI_MAX) {
+		return EIO;
+	}
+	memcpy(sy.tx, buf, len);
+	sy.tx[0] |= 0x80u;
+	return surya_spi(SPI_OP_TX, sy.tx, NULL, len);
+}
+
+/* nt36xxx.c CTP_SPI_READ: first byte & 0x7f, len + 1 bytes full duplex,
+ * data from the third received byte on goes to buf[1..len-1]. */
+static int
+surya_nvt_read(uint8_t *buf, unsigned len)
+{
+	if (len < 2 || len + 1u > SURYA_SPI_MAX) {
+		return EIO;
+	}
+	memset(sy.tx, 0, len + 1u);
+	memcpy(sy.tx, buf, len);
+	sy.tx[0] &= 0x7fu;
+	int err = surya_spi(SPI_OP_FULL, sy.tx, sy.rx, len + 1u);
+	if (!err) {
+		memcpy(buf + 1, sy.rx + 2, len - 1u);
+	}
+	return err;
+}
+
+static int
+surya_nvt_page(uint32_t addr)
+{
+	const uint8_t buf[3] = {0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7)};
+	return surya_nvt_write(buf, sizeof(buf));
+}
+
+static int
+surya_nvt_write_addr(uint32_t addr, uint8_t data)
+{
+	int err = surya_nvt_page(addr);
+	if (err) {
+		return err;
+	}
+	const uint8_t buf[2] = {(uint8_t)(addr & 0x7fu), data};
+	return surya_nvt_write(buf, sizeof(buf));
+}
+
+/* nt36xxx.c nvt_bootloader_reset + nvt_ts_check_chip_ver_trim. */
+static int
+surya_nvt_chip_id(uint8_t id[6])
+{
+	int err = surya_nvt_write_addr(NVT_SWRST_N8, 0x69);
+	if (err) {
+		return err;
+	}
+	touch_wait(5); /* tBRST2FR after bootloader reset */
+	err = surya_nvt_write_addr(NVT_RD_FAST, 0x00);
+	if (err) {
+		return err;
+	}
+	err = surya_nvt_page(NVT_CHIP_ID);
+	if (err) {
+		return err;
+	}
+	uint8_t buf[8] = {(uint8_t)(NVT_CHIP_ID & 0x7fu)};
+	err = surya_nvt_read(buf, 7);
+	if (!err) {
+		memcpy(id, buf + 1, 6);
+	}
+	return err;
+}
+
+static const char *
+surya_chip_name(const uint8_t id[6])
+{
+	for (unsigned k = 0; k < sizeof(surya_ids) / sizeof(surya_ids[0]); ++k) {
+		unsigned i;
+		for (i = 0; i < 6; ++i) {
+			if (surya_ids[k].mask[i] && id[i] != surya_ids[k].id[i]) {
+				break;
+			}
+		}
+		if (i == 6) {
+			return surya_ids[k].name;
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+nvt_le32(const uint8_t *p)
+{
+	return p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Read len-1 data bytes at addr into buf[1..] (page set first). */
+static int
+surya_nvt_read_at(uint32_t addr, uint8_t *buf, unsigned len)
+{
+	int err = surya_nvt_page(addr);
+	if (err) {
+		return err;
+	}
+	memset(buf, 0, len);
+	buf[0] = (uint8_t)(addr & 0x7fu);
+	return surya_nvt_read(buf, len);
+}
+
+/*
+ * update_firmware_request + nvt_bin_header_parser (hw_crc != 0: the CRCs come
+ * from the header). Checks every range against the file before any SPI write.
+ */
+static bool
+surya_fw_parse(const uint8_t *fw, unsigned size)
+{
+	unsigned need = 0;
+	for (unsigned i = size / 4096u; i > 0; --i) {
+		const uint8_t *flag = fw + i * 4096u - 3u;
+		if (!memcmp(flag, "NVT", 3) || !memcmp(flag, "MOD", 3)) {
+			need = i * 4096u;
+			break;
+		}
+	}
+	if (!need) {
+		printf("SURYA TOUCH: firmware has no NVT/MOD end flag\n");
+		return false;
+	}
+	nvt_fw_ver = fw[need - 4096u];
+	if (fw[need - 4096u] + fw[need - 4096u + 1u] != 0xff) {
+		printf("SURYA TOUCH: firmware version %#x + bar %#x != 0xff\n",
+		    fw[need - 4096u], fw[need - 4096u + 1u]);
+		return false;
+	}
+	uint32_t end = nvt_le32(fw);
+	unsigned info = 0;
+	for (uint32_t pos = 0x30u; pos < end; pos += 0x10u) {
+		++info;
+	}
+	unsigned ovly = (fw[0x28] & 0x10u) ? (fw[0x28] & 0x0fu) : 0u;
+	nvt_nparts = 2u + info + ovly;
+	if (nvt_nparts > NVT_FW_PARTS || 0x30u + 0x10u * info > size) {
+		printf("SURYA TOUCH: firmware header end=%#x info=%u ovly=%u is too large\n", end, info, ovly);
+		return false;
+	}
+	for (unsigned k = 0; k < nvt_nparts; ++k) {
+		const uint8_t *p;
+		if (k < 2u) {
+			p = fw + 12u * k;
+			nvt_parts[k].bin = nvt_le32(p);
+			nvt_parts[k].sram = nvt_le32(p + 4);
+			nvt_parts[k].size = nvt_le32(p + 8);
+			nvt_parts[k].crc = nvt_le32(fw + 0x18u + 4u * k);
+		} else {
+			uint32_t pos = k < 2u + info ? 0x30u + 0x10u * (k - 2u)
+			    : nvt_parts[1].bin + 0x10u * (k - 2u - info);
+			if (pos + 16u > size) {
+				printf("SURYA TOUCH: firmware header entry %u at %#x outside file\n", k, pos);
+				return false;
+			}
+			p = fw + pos;
+			nvt_parts[k].sram = nvt_le32(p);
+			nvt_parts[k].size = nvt_le32(p + 4);
+			nvt_parts[k].bin = nvt_le32(p + 8);
+			nvt_parts[k].crc = nvt_le32(p + 12);
+		}
+		/* nvt_write_firmware sends size + 1 bytes of a non-empty piece. */
+		if (nvt_parts[k].size &&
+		    ((uint64_t)nvt_parts[k].bin + nvt_parts[k].size + 1u > size)) {
+			printf("SURYA TOUCH: firmware piece %u bin=%#x size=%#x outside file\n",
+			    k, nvt_parts[k].bin, nvt_parts[k].size);
+			return false;
+		}
+	}
+	printf("SURYA TOUCH: firmware %u bytes, write size %#x, version %#x, %u pieces\n",
+	    size, need, fw[need - 4096u], nvt_nparts);
+	for (unsigned k = 0; k < nvt_nparts; ++k) {
+		if (nvt_parts[k].size) {
+			printf("SURYA TOUCH:   piece %u bin=%#x sram=%#x size=%#x crc=%#x\n", k,
+			    nvt_parts[k].bin, nvt_parts[k].sram, nvt_parts[k].size, nvt_parts[k].crc);
+		}
+	}
+	return true;
+}
+
+/* nvt_write_sram, in NVT_FW_CHUNK pieces: set page, then offset | 0x80 + data. */
+static int
+surya_nvt_sram(const uint8_t *data, uint32_t sram, uint32_t size)
+{
+	while (size) {
+		unsigned len = size < NVT_FW_CHUNK ? size : NVT_FW_CHUNK;
+		int err = surya_nvt_page(sram);
+		if (err) {
+			return err;
+		}
+		sy.big[0] = (uint8_t)((sram & 0x7fu) | 0x80u);
+		memcpy(sy.big + 1, data, len);
+		err = surya_spi(SPI_OP_TX, sy.big, NULL, len + 1u);
+		if (err) {
+			printf("SURYA TOUCH: sram write at %#x len %u failed %d\n", sram, len, err);
+			return err;
+		}
+		data += len;
+		sram += len;
+		size -= len;
+	}
+	return 0;
+}
+
+/* nvt_set_bld_crc_bank, hw_crc > 1: all three registers share one page. */
+static int
+surya_nvt_crc_bank(uint32_t des, uint32_t sram, uint32_t len_addr, uint32_t size,
+    uint32_t golden, uint32_t crc)
+{
+	int err = surya_nvt_page(des);
+	const uint8_t d[4] = {(uint8_t)(des & 0x7fu), (uint8_t)sram, (uint8_t)(sram >> 8), (uint8_t)(sram >> 16)};
+	const uint8_t l[4] = {(uint8_t)(len_addr & 0x7fu), (uint8_t)size, (uint8_t)(size >> 8),
+		                  (uint8_t)((size >> 16) & 1u)};
+	const uint8_t g[5] = {(uint8_t)(golden & 0x7fu), (uint8_t)crc, (uint8_t)(crc >> 8),
+		                  (uint8_t)(crc >> 16), (uint8_t)(crc >> 24)};
+	if (!err) {
+		err = surya_nvt_write(d, sizeof(d));
+	}
+	if (!err) {
+		err = surya_nvt_write(l, sizeof(l));
+	}
+	if (!err) {
+		err = surya_nvt_write(g, sizeof(g));
+	}
+	return err;
+}
+
+/* nvt_read_bld_hw_crc: CRC flags and golden/result sums after a failure. */
+static void
+surya_nvt_crc_dump(void)
+{
+	uint8_t b[8];
+	uint32_t gi = 0, ri = 0, gd = 0, rd = 0;
+	if (!surya_nvt_read_at(NVT_BLD_CRC_FLAG, b, 2)) {
+		printf("SURYA TOUCH: crc flag %#x (done=%u ilm_err=%u dlm_err=%u)\n",
+		    b[1], (b[1] >> 2) & 1u, b[1] & 1u, (b[1] >> 1) & 1u);
+	}
+	if (!surya_nvt_read_at(NVT_G_ILM_CHK, b, 5)) {
+		gi = nvt_le32(b + 1);
+	}
+	if (!surya_nvt_read_at(NVT_R_ILM_CHK, b, 5)) {
+		ri = nvt_le32(b + 1);
+	}
+	if (!surya_nvt_read_at(NVT_G_DLM_CHK, b, 5)) {
+		gd = nvt_le32(b + 1);
+	}
+	if (!surya_nvt_read_at(NVT_R_DLM_CHK, b, 5)) {
+		rd = nvt_le32(b + 1);
+	}
+	printf("SURYA TOUCH: ilm bin=%#x golden=%#x result=%#x; dlm bin=%#x golden=%#x result=%#x\n",
+	    nvt_parts[0].crc, gi, ri, nvt_parts[1].crc, gd, rd);
+}
+
+/* One pass of nvt_download_firmware_hw_crc; returns the reset state read last. */
+static int
+surya_nvt_download(const uint8_t *fw, uint8_t *state)
+{
+	uint8_t b[8];
+	*state = 0;
+	/* nvt_bootloader_reset */
+	int err = surya_nvt_write_addr(NVT_SWRST_N8, 0x69);
+	if (err) {
+		return err;
+	}
+	touch_wait(5);
+	if ((err = surya_nvt_write_addr(NVT_RD_FAST, 0x00))) {
+		return err;
+	}
+	/* nvt_write_firmware: every non-empty piece, size + 1 bytes. */
+	for (unsigned k = 0; k < nvt_nparts; ++k) {
+		if (nvt_parts[k].size &&
+		    (err = surya_nvt_sram(fw + nvt_parts[k].bin, nvt_parts[k].sram, nvt_parts[k].size + 1u))) {
+			return err;
+		}
+	}
+	/* nvt_set_bld_hw_crc: ILM and DLM destination, length, golden CRC. */
+	if ((err = surya_nvt_crc_bank(NVT_ILM_DES, nvt_parts[0].sram, NVT_ILM_LENGTH,
+	    nvt_parts[0].size, NVT_G_ILM_CHK, nvt_parts[0].crc)) ||
+	    (err = surya_nvt_crc_bank(NVT_DLM_DES, nvt_parts[1].sram, NVT_DLM_LENGTH,
+	    nvt_parts[1].size, NVT_G_DLM_CHK, nvt_parts[1].crc))) {
+		return err;
+	}
+	/* nvt_bld_crc_enable: set bit 7 of BLD_CRC_EN. */
+	if ((err = surya_nvt_read_at(NVT_BLD_CRC_EN, b, 2))) {
+		return err;
+	}
+	const uint8_t en[2] = {(uint8_t)(NVT_BLD_CRC_EN & 0x7fu), (uint8_t)(b[1] | 0x80u)};
+	if ((err = surya_nvt_write(en, sizeof(en)))) {
+		return err;
+	}
+	/* nvt_fw_crc_enable: clear reset status, host command 0xAE. */
+	const uint8_t clr[2] = {NVT_EV_RESET, 0x00};
+	const uint8_t cmd[2] = {NVT_EV_HOST_CMD, 0xae};
+	if ((err = surya_nvt_page(NVT_EVENT_BUF)) || (err = surya_nvt_write(clr, sizeof(clr))) ||
+	    (err = surya_nvt_write(cmd, sizeof(cmd)))) {
+		return err;
+	}
+	/* nvt_boot_ready */
+	if ((err = surya_nvt_write_addr(NVT_BOOT_RDY, 1))) {
+		return err;
+	}
+	touch_wait(5);
+	/* nvt_check_fw_reset_state(RESET_STATE_INIT): 0xA0..0xAF within ~100 ms. */
+	for (unsigned retry = 0; retry <= 10; ++retry) {
+		if ((err = surya_nvt_read_at(NVT_EVENT_BUF | NVT_EV_RESET, b, 6))) {
+			return err;
+		}
+		*state = b[1];
+		if (b[1] >= 0xa0u && b[1] <= 0xafu) {
+			return 0;
+		}
+		touch_wait(10);
+	}
+	return ETIMEDOUT;
+}
+
+/* Milestone 2: load, check, download; then nvt_get_fw_info + nvt_read_pid. */
+static bool
+surya_fw_load(void)
+{
+	DTEntry node;
+	const uint8_t *fw = NULL;
+	unsigned size = 0;
+	if (SecureDTLookupEntry(NULL, "/surya-touch", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "firmware", (void const **)&fw, &size) != kSuccess ||
+	    size < 4096u) {
+		printf("SURYA TOUCH: no /surya-touch firmware in the device tree\n");
+		return false;
+	}
+	if (!surya_fw_parse(fw, size)) {
+		return false;
+	}
+	int err = EIO;
+	uint8_t state = 0;
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	for (unsigned attempt = 0; attempt < 3 && !st.dead; ++attempt) {
+		err = surya_nvt_download(fw, &state);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		printf("SURYA TOUCH: download attempt %u err=%d reset state=%#x after %llu ms\n",
+		    attempt, err, state, ns / 1000000ull);
+		if (!err) {
+			break;
+		}
+	}
+	if (err) {
+		if (!st.dead) {
+			surya_nvt_crc_dump();
+		}
+		return false;
+	}
+	uint8_t b[20];
+	if (surya_nvt_read_at(NVT_EVENT_BUF | NVT_EV_FWINFO, b, 17)) {
+		return false;
+	}
+	unsigned ver = b[1], bar = b[2], x = b[3], y = b[4];
+	unsigned w = ((unsigned)b[5] << 8) | b[6], h = ((unsigned)b[7] << 8) | b[8];
+	printf("SURYA TOUCH: fw info ver=%#x ~ver=%#x grid=%ux%u max=%ux%u buttons=%u type=%#x\n",
+	    ver, bar, x, y, w, h, b[11], b[14]);
+	unsigned pid = 0;
+	if (!surya_nvt_read_at(NVT_EVENT_BUF | NVT_EV_PID, b, 3)) {
+		pid = ((unsigned)b[2] << 8) | b[1];
+		printf("SURYA TOUCH: pid=%04x\n", pid);
+	}
+	/*
+	 * Milestone 2 check: the running firmware is the file's, and its grid is
+	 * the one surya's DT gives for this PID (novatek-mp-criteria-5936: 18x36,
+	 * -5938: 16x36).
+	 */
+	unsigned want_x = pid == 0x5936u ? 18u : pid == 0x5938u ? 16u : 0u;
+	return ver + bar == 0xffu && ver == nvt_fw_ver && x == want_x && y == 36u;
+}
+
+static void
+surya_touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SURYA TOUCH: Novatek SPI milestones 1-2 (chip id, firmware) in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("SURYA TOUCH: mapping GCC/TLMM/SE0\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	sy.west = ml_io_map(SURYA_WEST_PA, 0x35000);
+	st.se = ml_io_map(SURYA_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !sy.west || !st.se) {
+		printf("SURYA TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SURYA TOUCH: before: spi cfg %#x %#x %#x %#x rst cfg=%#x io=%#x irq cfg=%#x io=%#x\n",
+	    touch_rd(sy.west, TOUCH_GPIO_CFG(49)), touch_rd(sy.west, TOUCH_GPIO_CFG(50)),
+	    touch_rd(sy.west, TOUCH_GPIO_CFG(51)), touch_rd(sy.west, TOUCH_GPIO_CFG(52)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(SURYA_RST_GPIO)), touch_rd(st.gpio, TOUCH_GPIO_IO(SURYA_RST_GPIO)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(SURYA_IRQ_GPIO)), touch_rd(st.gpio, TOUCH_GPIO_IO(SURYA_IRQ_GPIO)));
+	if (!surya_clocks() || !surya_se_init()) {
+		goto out;
+	}
+	for (unsigned pin = 49; pin <= 52; ++pin) {
+		surya_pin(sy.west, pin, 2, 0, 2, false, false); /* qup00, no pull, 6 mA */
+	}
+	/* Linux probe: reset requested low, then high, 10 ms after power-on reset. */
+	surya_pin(st.gpio, SURYA_RST_GPIO, 0, 0, 0, true, false);
+	touch_wait(5);
+	surya_pin(st.gpio, SURYA_RST_GPIO, 0, 0, 0, true, true);
+	touch_wait(20);
+	uint8_t id[6] = {0};
+	int err = EIO;
+	for (unsigned retry = 0; retry < 5 && !st.dead; ++retry) {
+		err = surya_nvt_chip_id(id);
+		printf("SURYA TOUCH: chip id try %u err=%d id=%02x %02x %02x %02x %02x %02x irq=%#x\n",
+		    retry, err, id[0], id[1], id[2], id[3], id[4], id[5], st.irq_status);
+		if (!err && surya_chip_name(id)) {
+			break;
+		}
+		touch_wait(10);
+	}
+	const char *name = err ? NULL : surya_chip_name(id);
+	printf("SURYA TOUCH: milestone 1 %s: %s\n", name ? "PASSED" : "FAILED",
+	    name ? name : "no Novatek id");
+	/* Only the 0c xx xx 72 66 03 chip uses the NT36675 map hard-coded above. */
+	if (!name || id[0] != 0x0cu || id[3] != 0x72u || id[4] != 0x66u || id[5] != 0x03u) {
+		goto out;
+	}
+	printf("SURYA TOUCH: milestone 2 %s\n", surya_fw_load() ? "PASSED" : "FAILED");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
