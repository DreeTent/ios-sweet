surya: read-only SPMI access to the PM6150 RTC and PM6150L WLED5

SweetBattery logs the RTC seconds once at start to learn whether surya's
RTC (not writable from Linux per its DT) holds epoch time. The backlight
observer reads the WLED5 control (0xd8) and sink (0xd9) blocks on SID 5 and
asks sweet_spmi_owner() which EE may write them. Reads only.

--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -83,14 +83,42 @@
 	return 0;
 }
 
+/*
+ * The APID that owns (sid, peripheral) and its write owner EE (cnfg + 0x700,
+ * bits 2:0, as spmi-pmic-arb.c's write_ee), or -1. Read-only bookkeeping:
+ * Linux writes a peripheral only when that owner is its own EE (0 = APPS).
+ * Declared here, not in sweet_spmi.h, to leave sweet's header untouched.
+ */
+int sweet_spmi_owner(unsigned sid, unsigned peripheral, unsigned *apid);
+
+int
+sweet_spmi_owner(unsigned sid, unsigned peripheral, unsigned *apid)
+{
+	if (!sp_ready || sid > 15 || peripheral > 0xff) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t a = sp_find_apid((sid << 8) | peripheral);
+	int owner = a == SP_NO_APID ? -1 : (int)(sp_rd(sp_cfg, 0x700u + 4u * a) & 7u);
+	IOLockUnlock(sp_lock);
+	if (apid) {
+		*apid = a;
+	}
+	return owner;
+}
+
 int
 sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
 	/* Restrict access to the battery blocks; keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
-	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
-	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	bool sid0 = sid == 0 &&
+	    (peripheral == 0x10 || peripheral == 0x11 || peripheral == 0x12 ||
+	    peripheral == 0x13 || peripheral == 0x48 ||
+	    peripheral == 0x60); /* 0x60: PM6150 RTC_RW, read by surya's battery log */
+	/* surya: PM6150L WLED5 control and sink on SID 5, for the backlight. */
+	bool sid5 = sid == 5 && (peripheral == 0xd8 || peripheral == 0xd9);
+	if (!sp_ready || !out || addr > 0xffffu || (!sid0 && !sid5)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
