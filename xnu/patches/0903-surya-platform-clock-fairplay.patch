sweet: platform clock hooks for a board RTC; FairPlayIOKit stand-in

IOPlatformExpert::getGMTTimeOfDay returns 0, so iOS started at 1970 on every
boot. SweetPlatformExpert now asks sweet_rtc_get_hook/sweet_rtc_set_hook
when a board driver sets them (surya: the PM6150 RTC in SweetBattery.cpp,
which then publishes the IORTC resource IOKitInitializeTime waits for).
Without hooks the behaviour is unchanged.

fairplayd.H2 exits at start when no com_apple_driver_FairPlayIOKit service
exists; launchd restarts it every 10 s and its clients wait forever (it held
up locationd and Settings > Date & Time). The platform expert now publishes a
stand-in with Apple's class names whose user client logs every call and
answers kIOReturnUnsupported. Boot-arg suryafairplay=0 leaves it out.
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -9,6 +9,23 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+/*
+ * Wall clock. IOPlatformExpert returns 0 from getGMTTimeOfDay, so iOS started
+ * at 1970 on every boot. A board driver that owns a real-time clock sets these
+ * hooks before publishing the IORTC resource that IOKitInitializeTime waits for
+ * (surya: the PM6150 RTC, iokit/Kernel/arm/SweetBattery.cpp). Without hooks
+ * nothing changes.
+ */
+extern "C" {
+long (*sweet_rtc_get_hook)(void) = NULL;
+void (*sweet_rtc_set_hook)(long secs) = NULL;
+}
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -18,10 +35,117 @@
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	long getGMTTimeOfDay(void) APPLE_KEXT_OVERRIDE;
+	void setGMTTimeOfDay(long secs) APPLE_KEXT_OVERRIDE;
 };
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	return sweet_rtc_get_hook ? sweet_rtc_get_hook() : IODTPlatformExpert::getGMTTimeOfDay();
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	if (sweet_rtc_set_hook) {
+		sweet_rtc_set_hook(secs);
+	} else {
+		IODTPlatformExpert::setGMTTimeOfDay(secs);
+	}
+}
+
+/*
+ * surya: FairPlayIOKit stand-in. fairplayd.H2 looks up the IOService class
+ * com_apple_driver_FairPlayIOKit at start and exits when there is none; launchd
+ * (KeepAlive) restarts it every 10 s and its clients wait forever for answers
+ * (locationd's Harvest asking for a Mescal signature held a dispatch queue, and
+ * Settings > General > Date & Time hung behind it). Apple's kext is closed and
+ * built on the device's hardware AES keys; this stand-in only lets fairplayd
+ * find a driver: every user-client call is logged and answered
+ * kIOReturnUnsupported, nothing is encrypted or faked. Class names are Apple's,
+ * since fairplayd matches by class. Boot-arg suryafairplay=0 leaves it out.
+ */
+class com_apple_driver_FairPlayIOKit : public IOService {
+	OSDeclareDefaultStructors(com_apple_driver_FairPlayIOKit);
+};
+
+OSDefineMetaClassAndStructors(com_apple_driver_FairPlayIOKit, IOService);
+
+class com_apple_driver_FairPlayIOKitUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(com_apple_driver_FairPlayIOKitUserClient);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(com_apple_driver_FairPlayIOKitUserClient, IOUserClient);
+
+bool
+com_apple_driver_FairPlayIOKitUserClient::initWithTask(task_t owningTask, void *securityID,
+    UInt32 type, OSDictionary *properties)
+{
+	char name[32];
+	proc_selfname(name, (int)sizeof(name));
+	IOLog("SURYA FAIRPLAY: open by %s[%d] type %u\n", name, proc_selfpid(), (unsigned)type);
+	return IOUserClient::initWithTask(owningTask, securityID, type, properties);
+}
+
+IOReturn
+com_apple_driver_FairPlayIOKitUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+com_apple_driver_FairPlayIOKitUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+	char name[32];
+	proc_selfname(name, (int)sizeof(name));
+	IOLog("SURYA FAIRPLAY: %s[%d] sel %u in %u/%u%s out %u/%u%s -> unsupported\n",
+	    name, proc_selfpid(), selector, args->scalarInputCount, args->structureInputSize,
+	    args->structureInputDescriptor != NULL ? "+desc" : "",
+	    args->scalarOutputCount, args->structureOutputSize,
+	    args->structureOutputDescriptor != NULL ? "+desc" : "");
+	return kIOReturnUnsupported;
+}
+
+static void
+surya_fairplay_publish(IOService *provider)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("suryafairplay", &on, sizeof(on));
+	if (!on) {
+		IOLog("SURYA FAIRPLAY: stand-in off (suryafairplay=0)\n");
+		return;
+	}
+	com_apple_driver_FairPlayIOKit *fp = OSTypeAlloc(com_apple_driver_FairPlayIOKit);
+	if (fp == NULL || !fp->init()) {
+		OSSafeReleaseNULL(fp);
+		return;
+	}
+	fp->setProperty(kIOUserClientClassKey, "com_apple_driver_FairPlayIOKitUserClient");
+	if (fp->attach(provider)) {
+		if (fp->start(provider)) {
+			fp->registerService();
+			IOLog("SURYA FAIRPLAY: stand-in registered (every call answered unsupported)\n");
+		} else {
+			fp->detach(provider);
+		}
+	}
+	fp->release();
+}
+
 bool
 SweetPlatformExpert::start(IOService *provider)
 {
@@ -31,6 +155,7 @@
 	}
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
+	surya_fairplay_publish(this);
 	return true;
 }
 
