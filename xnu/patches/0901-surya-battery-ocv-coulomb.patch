+/* High, low, high: a pair is consistent when both high bytes match. Unlike
+ * readWord this accepts a sample that changes every read (the current). */
+bool
+SweetBattery::readWordHL(unsigned address, uint16_t *value)
+{
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t hi, lo, hi2;
+		if (sweet_spmi_read(0, address + 1, &hi) ||
+		    sweet_spmi_read(0, address, &lo) ||
+		    sweet_spmi_read(0, address + 1, &hi2)) {
+			return false;
+		}
+		if (hi == hi2) {
+			*value = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+			return true;
+		}
+	}
+	return false;
+}
+
+/* /surya-battery from the locally built ADT: capacity and OCV(SOC) at 25 C. */
+bool
+SweetBattery::suryaTable(void)
+{
+	DTEntry node;
+	const uint32_t *cap = NULL;
+	unsigned capSize = 0, pctSize = 0, uvSize = 0;
+	if (SecureDTLookupEntry(NULL, "/surya-battery", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "capacity-mah", (void const **)&cap, &capSize) != kSuccess ||
+	    SecureDTGetProperty(node, "ocv-pct", (void const **)&fOcvPct, &pctSize) != kSuccess ||
+	    SecureDTGetProperty(node, "ocv-uv", (void const **)&fOcvUv, &uvSize) != kSuccess) {
+		return false;
+	}
+	fOcvCount = pctSize / 4u;
+	if (capSize != 4 || pctSize != uvSize || pctSize % 4u || fOcvCount < 2 ||
+	    fOcvCount > SURYA_OCV_MAX || *cap < 1000 || *cap > 10000) {
+		IOLog("SURYA BATTERY: malformed /surya-battery (cap %u, %u/%u bytes)\n",
+		    capSize == 4 ? *cap : 0, pctSize, uvSize);
+		return false;
+	}
+	for (unsigned i = 1; i < fOcvCount; ++i) {
+		if (fOcvPct[i] >= fOcvPct[i - 1] || fOcvUv[i] >= fOcvUv[i - 1]) {
+			IOLog("SURYA BATTERY: /surya-battery table not descending at %u\n", i);
+			return false;
+		}
+	}
+	fDesignMah = *cap;
+	fCapNah = (int64_t)fDesignMah * 1000000;
+	return true;
+}
+
+/* SOC x 100 for an open-circuit voltage: linear between table points. */
+unsigned
+SweetBattery::suryaSoc100(unsigned uv) const
+{
+	if (uv >= fOcvUv[0]) {
+		return fOcvPct[0];
+	}
+	for (unsigned i = 1; i < fOcvCount; ++i) {
+		if (uv >= fOcvUv[i]) {
+			return fOcvPct[i] + (unsigned)((uint64_t)(uv - fOcvUv[i]) *
+			       (fOcvPct[i - 1] - fOcvPct[i]) / (fOcvUv[i - 1] - fOcvUv[i]));
+		}
+	}
+	return fOcvPct[fOcvCount - 1];
+}
+
+/* LAST_ADC_I, the register sweet reads; positive = charging, as publish(). */
+bool
+SweetBattery::suryaCurrent(int *ma) const
+{
+	uint16_t raw;
+	if ((fSubtype != 3 && fSubtype != 4) || !readWordHL(0x48c2, &raw) || raw == 0x8000) {
+		return false;
+	}
+	int signedRaw = (raw & 0x8000u) ? (int)raw - 65536 : (int)raw;
+	*ma = (int)(-((int64_t)signedRaw * (fSubtype == 3 ? 152588 : 305176)) / 1000000);
+	return true;
+}
+
+/*
+ * Start SOC. The QG's power-on OCV (qg_determine_pon_soc's S7_PON_OCV) is a
+ * no-load reading, but only from the last cold power-on: the keys-to-fastboot
+ * reset does not repeat it (20.10: S7 3425 mV with the cell at 4190 mV). So S7
+ * is used only when it agrees with the present voltage corrected for the
+ * load (V - I*R); otherwise that corrected voltage is the start. Same table.
+ */
+unsigned
+SweetBattery::suryaOcvNow(void) const
+{
+	uint16_t raw;
+	if (!readWordHL(0x48c0, &raw) || !raw || raw == 0x8000) {
+		return 0;
+	}
+	int64_t uv = (int64_t)QG_V_RAW_TO_UV(raw) - (int64_t)fLastMa * SURYA_RBATT_MOHM;
+	return uv > 0 ? (unsigned)uv : 0;
+}
+
+void
+SweetBattery::suryaStart(void)
+{
+	uint16_t raw = 0;
+	unsigned s7 = 0, now, uv;
+	int ma;
+	if (suryaCurrent(&ma)) {
+		fLastMa = ma;
+	}
+	if (readWord(0x4870, &raw) && raw && raw != 0x8000) {
+		s7 = QG_V_RAW_TO_UV(raw);
+	}
+	now = suryaOcvNow();
+	fS7Mv = s7 / 1000u;
+	if (s7 >= 3000000u && s7 <= 4500000u && now &&
+	    (s7 > now ? s7 - now : now - s7) <= SURYA_S7_MATCH_UV) {
+		fStartSource = "S7_PON_OCV";
+		uv = s7;
+	} else {
+		fStartSource = "V-IR";
+		uv = now;
+	}
+	if (uv < 3000000u || uv > 4500000u) {
+		fStartSource = "none";
+		return;
+	}
+	fStartMv = uv / 1000u;
+	fRtcSec = suryaRtc();
+	fChargeNah = fCapNah * suryaSoc100(uv) / 10000;
+	fLastAbs = mach_absolute_time();
+	fSuryaValid = true;
+	IOLog("SURYA BATTERY: start %s %umV -> %u.%02u%% of %umAh\n", fStartSource,
+	    fStartMv, (unsigned)(fChargeNah * 10000 / fCapNah) / 100u,
+	    (unsigned)(fChargeNah * 10000 / fCapNah) % 100u, fDesignMah);
+}
+
+/* Every second: integrate the battery current since the previous sample. */
+void
+SweetBattery::suryaSample(void)
+{
+	uint64_t now = mach_absolute_time(), ns = 0;
+	absolutetime_to_nanoseconds(now - fLastAbs, &ns);
+	fLastAbs = now;
+	int ma;
+	if (suryaCurrent(&ma)) {
+		fLastMa = ma;
+	}
+	if (!fSuryaValid) {
+		return;
+	}
+	if (ns > 60ull * 1000000000ull) {
+		IOLog("SURYA BATTERY: %llu ms without a sample; not counted\n", ns / 1000000ull);
+		return;
+	}
+	/* mA x ns -> nAh: 1 mAh = 3.6e12 mA*ns per 1e6 nAh. */
+	fChargeNah += (int64_t)fLastMa * (int64_t)ns / 3600000;
+	if (fChargeNah < 0) {
+		fChargeNah = 0;
+	} else if (fChargeNah > fCapNah) {
+		fChargeNah = fCapNah;
+	}
+}
+
+/*
+ * PM6150 RTC seconds (RTC_RW 0x6040..0x6043, as rtc-pm8xxx: read the four
+ * bytes, re-read byte 0 and retry on rollover). Surya's DT forbids Linux
+ * from writing it (qpnp-rtc-write = 0), so whether it is epoch time is what
+ * this log is for; XNU itself gets 0 from the generic platform expert.
+ */
+uint32_t
+SweetBattery::suryaRtc(void)
+{
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		uint8_t b[4], again;
+		bool ok = true;
+		for (unsigned i = 0; i < 4 && ok; ++i) {
+			ok = !sweet_spmi_read(0, 0x6040u + i, &b[i]);
+		}
+		if (!ok || sweet_spmi_read(0, 0x6040u, &again)) {
+			return 0xffffffffu; /* read failed, as opposed to a zero counter */
+		}
+		if (again >= b[0]) {
+			return (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) |
+			       ((uint32_t)b[3] << 24);
+		}
+	}
+	return 0xffffffffu;
+}
+
+/*
+ * Why the charger gives what it gives, read-only: APSD result (charger type),
+ * the USBIN ICL setting and the DCDC/AICL ICL status (qpnp-smb5.c pm8150b
+ * params, which PM6150 uses: 50 mA steps), ICL mode bits and the FCC setting.
+ * Logged when any byte changes.
+ */
+void
+SweetBattery::suryaChargerLog(void)
+{
+	static const uint16_t regs[] = {
+		0x1307, /* APSD_STATUS */
+		0x1308, /* APSD_RESULT_STATUS */
+		0x1366, /* USBIN_ICL_OPTIONS: USB51_MODE bit1, USBIN_MODE_CHG bit0 */
+		0x1370, /* USBIN_CURRENT_LIMIT_CFG */
+		0x1342, /* CMD_ICL_OVERRIDE */
+		0x1365, /* USBIN_LOAD_CFG: ICL_OVERRIDE_AFTER_APSD bit4 */
+		0x1106, /* ICL_MAX_STATUS */
+		0x1107, /* ICL_STATUS */
+		0x1108, /* AICL_ICL_STATUS */
+		0x110a, /* AICL_STATUS: AICL_DONE bit0 */
+		0x1061, /* CHGR_FAST_CHARGE_CURRENT_CFG */
+	};
+	uint8_t v[sizeof(regs) / sizeof(regs[0])];
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		if (sweet_spmi_read(0, regs[i], &v[i])) {
+			return;
+		}
+	}
+	if (fChgLogged && !memcmp(v, fChgLast, sizeof(v))) {
+		return;
+	}
+	memcpy(fChgLast, v, sizeof(v));
+	fChgLogged = true;
+	uint8_t r = v[1] & 0x7fu;
+	const char *type = (r & 0x40u) ? "QC3" : (r & 0x20u) ? "QC2" : (r & 0x10u) ? "FLOAT" :
+	    (r & 0x08u) ? "DCP" : (r & 0x04u) ? "CDP" : (r & 0x02u) ? "OCP" : (r & 0x01u) ? "SDP" : "none";
+	IOLog("SURYA CHARGER: apsd=%#x/%#x %s icl cfg=%umA max=%umA status=%umA aicl=%umA done=%u "
+	    "opts=%#x override=%#x load=%#x fcc=%umA\n",
+	    v[0], v[1], type, v[3] * 50u, v[6] * 50u, v[7] * 50u, v[8] * 50u, v[9] & 1u,
+	    v[2], v[4], v[5], v[10] * 50u);
+}
+
+/* Every 30 s: charger state, publish, one log line. A failed read keeps the
+ * last published values instead of sweet's 100% fallback. */
+void
+SweetBattery::suryaPoll(void)
+{
+	if (!fSuryaValid) {
+		suryaStart();
+	}
+	uint8_t type, present, usb, path, charger, error, temperature;
+	uint16_t rawVoltage;
+	bool valid = fSuryaValid &&
+	    !sweet_spmi_read(0, 0x4804, &type) && type == 0x0d &&
+	    !sweet_spmi_read(0, 0x4808, &present) && (present & 1u) &&
+	    readWordHL(0x48c0, &rawVoltage) && rawVoltage != 0x8000 &&
+	    !sweet_spmi_read(0, 0x1310, &usb) &&
+	    !sweet_spmi_read(0, 0x110b, &path) &&
+	    !sweet_spmi_read(0, 0x1006, &charger) &&
+	    !sweet_spmi_read(0, 0x1007, &error) &&
+	    !sweet_spmi_read(0, 0x100d, &temperature);
+	unsigned mv = valid ? QG_V_RAW_TO_UV(rawVoltage) / 1000u : 0;
+	valid = valid && mv >= 2800 && mv <= 4600;
+	if (!valid) {
+		if ((fFailures++ % 10u) == 0) {
+			IOLog("SURYA BATTERY: read failed (%u), start %s; keeping last values\n",
+			    fFailures, fStartSource);
+		}
+		if (!fPublished) {
+			publish(100, 4200, 0, true, true, false, true, false, false);
+		}
+		return;
+	}
+	fFailures = 0;
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(error & 2u) && !(temperature & 0x0cu);
+	bool full = external && state == 5 && !(error & 2u);
+	unsigned ocv = suryaOcvNow(), vsoc100 = ocv ? suryaSoc100(ocv) : 0;
+	if (full) {
+		fChargeNah = fCapNah; /* SMB5 terminated the charge */
+	} else if (ocv) {
+		/* Slow pull toward the load-corrected voltage, so a wrong start or
+		 * counter drift heals without a visible jump. */
+		int64_t target = fCapNah * vsoc100 / 10000, step = (target - fChargeNah) / SURYA_NUDGE_DIV;
+		int64_t cap = fCapNah * SURYA_NUDGE_MAX / 10000;
+		fChargeNah += step > cap ? cap : (step < -cap ? -cap : step);
+	}
+	unsigned soc100 = (unsigned)(fChargeNah * 10000 / fCapNah);
+	unsigned percent = (soc100 + 50u) / 100u;
+	percent = percent < 1u ? 1u : (percent > 100u ? 100u : percent);
+	publish(percent, mv, fLastMa, external, capable, charging, full, true, true);
+	fPublished = true;
+	IOLog("SURYA BATTERY: soc=%u.%02u%% v=%umV i=%dmA ocv=%umV vsoc=%u.%02u%% ext=%d chg=%d state=%u "
+	    "full=%d start=%s %umV s7=%umV rtc0=%#x\n",
+	    soc100 / 100u, soc100 % 100u, mv, fLastMa, ocv / 1000u, vsoc100 / 100u, vsoc100 % 100u,
+	    external, charging, state, full, fStartSource, fStartMv, fS7Mv, fRtcSec);
+	suryaChargerLog();
+}
