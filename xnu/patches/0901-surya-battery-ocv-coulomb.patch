+/*
+ * Why the charger gives what it gives, read-only: APSD result (charger type),
+ * the USBIN ICL setting and the DCDC/AICL ICL status (qpnp-smb5.c pm8150b
+ * params, which PM6150 uses: 50 mA steps), ICL mode bits and the FCC setting.
+ * Logged when any byte changes.
+ */
+void
+SweetBattery::suryaChargerLog(void)
+{
+	static const uint16_t regs[] = {
+		0x1307, /* APSD_STATUS */
+		0x1308, /* APSD_RESULT_STATUS */
+		0x1366, /* USBIN_ICL_OPTIONS: USB51_MODE bit1, USBIN_MODE_CHG bit0 */
+		0x1370, /* USBIN_CURRENT_LIMIT_CFG */
+		0x1342, /* CMD_ICL_OVERRIDE */
+		0x1365, /* USBIN_LOAD_CFG: ICL_OVERRIDE_AFTER_APSD bit4 */
+		0x1106, /* ICL_MAX_STATUS */
+		0x1107, /* ICL_STATUS */
+		0x1108, /* AICL_ICL_STATUS */
+		0x110a, /* AICL_STATUS: AICL_DONE bit0 */
+		0x1061, /* CHGR_FAST_CHARGE_CURRENT_CFG */
+	};
+	uint8_t v[sizeof(regs) / sizeof(regs[0])];
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		if (sweet_spmi_read(0, regs[i], &v[i])) {
+			return;
+		}
+	}
+	if (fChgLogged && !memcmp(v, fChgLast, sizeof(v))) {
+		return;
+	}
+	memcpy(fChgLast, v, sizeof(v));
+	fChgLogged = true;
+	uint8_t r = v[1] & 0x7fu;
+	const char *type = (r & 0x40u) ? "QC3" : (r & 0x20u) ? "QC2" : (r & 0x10u) ? "FLOAT" :
+	    (r & 0x08u) ? "DCP" : (r & 0x04u) ? "CDP" : (r & 0x02u) ? "OCP" : (r & 0x01u) ? "SDP" : "none";
+	IOLog("SURYA CHARGER: apsd=%#x/%#x %s icl cfg=%umA max=%umA status=%umA aicl=%umA done=%u "
+	    "opts=%#x override=%#x load=%#x fcc=%umA\n",
+	    v[0], v[1], type, v[3] * 50u, v[6] * 50u, v[7] * 50u, v[8] * 50u, v[9] & 1u,
+	    v[2], v[4], v[5], v[10] * 50u);
+}
+
+/* Every 30 s: charger state, publish, one log line. A failed read keeps the
+ * last published values instead of sweet's 100% fallback. */
+void
+SweetBattery::suryaPoll(void)
+{
+	if (!fSuryaValid) {
+		suryaStart();
+	}
+	uint8_t type, present, usb, path, charger, error, temperature;
+	uint16_t rawVoltage;
+	bool valid = fSuryaValid &&
+	    !sweet_spmi_read(0, 0x4804, &type) && type == 0x0d &&
+	    !sweet_spmi_read(0, 0x4808, &present) && (present & 1u) &&
+	    readWordHL(0x48c0, &rawVoltage) && rawVoltage != 0x8000 &&
+	    !sweet_spmi_read(0, 0x1310, &usb) &&
+	    !sweet_spmi_read(0, 0x110b, &path) &&
+	    !sweet_spmi_read(0, 0x1006, &charger) &&
+	    !sweet_spmi_read(0, 0x1007, &error) &&
+	    !sweet_spmi_read(0, 0x100d, &temperature);
+	unsigned mv = valid ? QG_V_RAW_TO_UV(rawVoltage) / 1000u : 0;
+	valid = valid && mv >= 2800 && mv <= 4600;
+	if (!valid) {
+		if ((fFailures++ % 10u) == 0) {
+			IOLog("SURYA BATTERY: read failed (%u), start %s; keeping last values\n",
+			    fFailures, fStartSource);
+		}
+		if (!fPublished) {
+			publish(100, 4200, 0, true, true, false, true, false, false);
+		}
+		return;
+	}
+	fFailures = 0;
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(error & 2u) && !(temperature & 0x0cu);
+	bool full = external && state == 5 && !(error & 2u);
+	unsigned ocv = suryaOcvNow(), vsoc100 = ocv ? suryaSoc100(ocv) : 0;
+	if (full) {
+		fChargeNah = fCapNah; /* SMB5 terminated the charge */
+	} else if (ocv) {
+		/* Slow pull toward the load-corrected voltage, so a wrong start or
+		 * counter drift heals without a visible jump. */
+		int64_t target = fCapNah * vsoc100 / 10000, step = (target - fChargeNah) / SURYA_NUDGE_DIV;
+		int64_t cap = fCapNah * SURYA_NUDGE_MAX / 10000;
+		fChargeNah += step > cap ? cap : (step < -cap ? -cap : step);
+	}
+	unsigned soc100 = (unsigned)(fChargeNah * 10000 / fCapNah);
+	unsigned percent = (soc100 + 50u) / 100u;
+	percent = percent < 1u ? 1u : (percent > 100u ? 100u : percent);
+	publish(percent, mv, fLastMa, external, capable, charging, full, true, true);
+	fPublished = true;
+	fLedExt = external;
+	fLedChg = charging;
+	fLedPct = percent;
+	IOLog("SURYA BATTERY: soc=%u.%02u%% v=%umV i=%dmA ocv=%umV vsoc=%u.%02u%% ext=%d chg=%d state=%u "
+	    "full=%d start=%s %umV s7=%umV rtc0=%u clock=%d now=%u time=%ld\n",
+	    soc100 / 100u, soc100 % 100u, mv, fLastMa, ocv / 1000u, vsoc100 / 100u, vsoc100 % 100u,
+	    external, charging, state, full, fStartSource, fStartMv, fS7Mv, fRtcSec, fRtcCtrl,
+	    surya_rtc_read(), surya_time_get());
+	suryaChargerLog();
+}
+
 void
 SweetBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
 {
 	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
 	if (self && self->fRunning) {
+		if (self->fSurya) {
+			if (!self->fTimeDone) {
+				self->fTimeDone = surya_time_tick() != 0;
+			}
+			if (self->fBacklight) {
+				surya_backlight_tick(self->fBacklight);
+			}
+			surya_led_tick(self->fLedExt, self->fLedChg, self->fLedPct);
+			self->suryaSample();
+			if (++self->fTick % SURYA_PUBLISH_N == 0) {
+				self->suryaPoll();
+			}
+			sender->setTimeoutMS(SURYA_SAMPLE_MS);
+			return;
+		}
 		self->poll();
 		sender->setTimeoutMS(30000);
 	}
 }
 
+/*
+ * surya backlight, named like iPhone X's driver. CoreBrightness/backboardd find
+ * it by backlight-control = true; the ADT /backlight node comes from
+ * scripts/adt-backlight.py. Observed 20.10 (step 1): with IODisplayParameters
+ * brightness 0..1024 and no nits tables, iOS sends {brightness, backlight-level,
+ * FadePeriod}: 1..1014 from the slider, 0 on lock (then the framebuffer goes
+ * dark), the old level after unlock. So only "brightness" is acted on:
+ * 0 turns the PM6150L WLED5 module off, N > 0 sets level N * 4095 / 1024
+ * (at least 42, above the 1 % where Linux needs its sample-and-hold
+ * workaround) the way qcom-spmi-wled.c does: MOD_A brightness LSB/MSB,
+ * sync bit 0 set then bits 3:0 cleared, module enable with 10 ms soft start.
+ * Everything set on it is still logged, up to 600 lines.
+ */
+/*
+ * Brightness across reboots (21.10): iOS reads IODisplayParameters brightness
+ * "value" as the current level and fades from it to its own setting, and the
+ * WLED keeps the bootloader's level 2047 until iOS speaks. The last non-zero
+ * brightness iOS set is kept in SURYA_BL_FILE (written 2 s after the last
+ * change, from SweetBattery's 1 s timer); once the root is mounted it is read
+ * back, applied to the WLED unless iOS already set one, and published as the
+ * current "value" instead of a fixed 512.
+ */
+#define SURYA_BL_FILE  "/private/var/db/surya-backlight"
+#define SURYA_BL_MAGIC 0x5352424cu /* "SRBL" */
+#define SURYA_BL_SAVE_NS 2000000000ULL
+
+struct surya_bl_rec {
+	uint32_t magic, version, brightness, reserved;
+};
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn message(UInt32 type, IOService *provider, void *argument) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+	void tick(void);
+private:
+	unsigned fLines;
+	int fLevel;          /* WLED level now: 0 off, -1 unknown */
+	bool fSnapshotDone;
+	IOLock *fLock;
+	unsigned fSaved;     /* last non-zero brightness from iOS (or restored) */
+	bool fFromIOS, fDirty, fRestored;
+	uint64_t fChangedNs;
+	void logObject(const char *what, OSObject *object);
+	void logSnapshot(void);
+	void applyBrightness(unsigned brightness);
+	void publishParams(unsigned value);
+};
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static void
+surya_backlight_tick(OSObject *backlight)
+{
+	AppleARMBacklight *bl = OSDynamicCast(AppleARMBacklight, backlight);
+	if (bl) {
+		bl->tick();
+	}
+}
+
+void
+AppleARMBacklight::logObject(const char *what, OSObject *object)
+{
+	if (fLines >= 600) {
+		return;
+	}
+	++fLines;
+	OSSerialize *s = OSSerialize::withCapacity(512);
+	if (s && object && object->serialize(s)) {
+		IOLog("SURYA BACKLIGHT: %s %.900s\n", what, s->text());
+	} else {
+		IOLog("SURYA BACKLIGHT: %s (not serializable)\n", what);
+	}
+	OSSafeReleaseNULL(s);
+}
+
+/* Read-only WLED5 snapshot and who may write it; also sets fLevel. */
+void
+AppleARMBacklight::logSnapshot(void)
+{
+	unsigned capid = 0, sapid = 0;
+	int cown = sweet_spmi_owner(5, 0xd8, &capid), sown = sweet_spmi_owner(5, 0xd9, &sapid);
+	static const uint16_t regs[] = {0xd807, 0xd808, 0xd846, 0xd946, 0xd950, 0xd951, 0xd952,
+		                        0xd953, 0xd954, 0xd965, 0xd972, 0xd973};
+	uint8_t v[sizeof(regs) / sizeof(regs[0])];
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		if (sweet_spmi_read(5, regs[i], &v[i])) {
+			v[i] = 0xee;
+			ok = false;
+		}
+	}
+	if (ok) {
+		fLevel = (v[2] & 0x80u) ? (int)((((unsigned)v[8] & 0x0fu) << 8) | v[7]) : 0;
+	}
+	IOLog("SURYA BACKLIGHT: WLED ctrl apid %u owner %d, sink apid %u owner %d; "
+	    "status %#x fault %#x mod_en %#x | sink_en %#x modA_en %#x src %#x wid %#x "
+	    "brt %#x%02x sync %#x fs %#x %#x; level %d\n",
+	    capid, cown, sapid, sown, v[0], v[1], v[2], v[3], v[4], v[5], v[6],
+	    v[8], v[7], v[9], v[10], v[11], fLevel);
+}
+
+void
+AppleARMBacklight::applyBrightness(unsigned brightness)
+{
+	unsigned level = 0;
+	if (brightness) {
+		uint64_t l = (uint64_t)brightness * 4095u / 1024u;
+		level = l < 42u ? 42u : (l > 4095u ? 4095u : (unsigned)l);
+	}
+	if ((int)level == fLevel) {
+		return;
+	}
+	int err = 0;
+	uint8_t en = 0, sync = 0;
+	if (level) {
+		err |= sweet_spmi_write(5, 0xd953, (uint8_t)(level & 0xffu));
+		err |= sweet_spmi_write(5, 0xd954, (uint8_t)((level >> 8) & 0x0fu));
+		/* The level latches on the MOD_A sync bit's 0 -> 1 edge. The
+		 * bootloader leaves the bit set (sync 0x1 in the first snapshot), so
+		 * qcom-spmi-wled's set-then-clear alone missed the first level after
+		 * boot (the restored brightness stayed at the bootloader's 2047):
+		 * clear, set, clear. */
+		err |= sweet_spmi_read(5, 0xd965, &sync);
+		err |= sweet_spmi_write(5, 0xd965, (uint8_t)(sync & ~0xfu));
+		err |= sweet_spmi_write(5, 0xd965, (uint8_t)((sync & ~0xfu) | 0x1u));
+		err |= sweet_spmi_write(5, 0xd965, (uint8_t)(sync & ~0xfu));
+		if (fLevel <= 0) {
+			err |= sweet_spmi_read(5, 0xd846, &en);
+			if (!(en & 0x80u)) {
+				err |= sweet_spmi_write(5, 0xd846, (uint8_t)(en | 0x80u));
+				IOSleep(10); /* WLED_SOFT_START_DLY_US */
+			}
+		}
+	} else {
+		err |= sweet_spmi_read(5, 0xd846, &en);
+		err |= sweet_spmi_write(5, 0xd846, (uint8_t)(en & ~0x80u));
+	}
+	if (fLines < 600) {
+		++fLines;
+		IOLog("SURYA BACKLIGHT: brightness %u -> WLED level %u (was %d)%s\n",
+		    brightness, level, fLevel, err ? " FAILED" : "");
+	}
+	fLevel = err ? -1 : (int)level;
+}
+
+bool
+AppleARMBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fLines = 0;
+	fLevel = -1;
+	fSnapshotDone = false;
+	fLock = IOLockAlloc();
+	if (!fLock) {
+		return false;
+	}
+	fSaved = 0;
+	fFromIOS = fDirty = fRestored = false;
+	fChangedNs = 0;
+	setProperty("backlight-control", kOSBooleanTrue);
+	publishParams(512);
+	registerService();
+	IOLog("SURYA BACKLIGHT: registered (backlight-control)\n");
+	return true;
+}
+
+/* IODisplayParameters brightness {min 0, max 1024, value}. */
+void
+AppleARMBacklight::publishParams(unsigned value)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSNumber *mn = OSNumber::withNumber(0ULL, 32), *mx = OSNumber::withNumber(1024ULL, 32),
+	    *val = OSNumber::withNumber((unsigned long long)value, 32);
+	if (params && brightness && mn && mx && val) {
+		brightness->setObject("min", mn);
+		brightness->setObject("max", mx);
+		brightness->setObject("value", val);
+		params->setObject("brightness", brightness);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(mn);
+	OSSafeReleaseNULL(mx);
+	OSSafeReleaseNULL(val);
+	OSSafeReleaseNULL(brightness);
+	OSSafeReleaseNULL(params);
+}
+
+/* SweetBattery's 1 s timer: restore once the root is mounted, save after changes. */
+void
+AppleARMBacklight::tick(void)
+{
+	uint64_t now = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now);
+	IOLockLock(fLock);
+	if (!fRestored && surya_root_ready()) {
+		fRestored = true;
+		struct surya_bl_rec rec;
+		bzero(&rec, sizeof(rec));
+		int err = surya_db_rw(SURYA_BL_FILE, 0, &rec, (int)sizeof(rec));
+		if (err || rec.magic != SURYA_BL_MAGIC || rec.version != 1 ||
+		    rec.brightness == 0 || rec.brightness > 1024) {
+			IOLog("SURYA BACKLIGHT: no saved brightness (err=%d magic=%#x value=%u)\n",
+			    err, rec.magic, rec.brightness);
+		} else {
+			bool apply = !fFromIOS;
+			if (apply) {
+				fSaved = rec.brightness;
+				applyBrightness(rec.brightness);
+			}
+			publishParams(fFromIOS ? fSaved : rec.brightness);
+			IOLog("SURYA BACKLIGHT: restored brightness %u%s\n", rec.brightness,
+			    apply ? "" : " (iOS already set one: published only)");
+		}
+	}
+	if (fDirty && fSaved && now - fChangedNs >= SURYA_BL_SAVE_NS && surya_root_ready()) {
+		fDirty = false;
+		struct surya_bl_rec rec = {SURYA_BL_MAGIC, 1, fSaved, 0};
+		int err = surya_db_rw(SURYA_BL_FILE, 1, &rec, (int)sizeof(rec));
+		IOLog("SURYA BACKLIGHT: saved brightness %u err=%d\n", fSaved, err);
+	}
+	IOLockUnlock(fLock);
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	IOLockLock(fLock);
+	if (!fSnapshotDone) {
+		/* At start the USB log is not up yet: take the snapshot here. */
+		fSnapshotDone = true;
+		logSnapshot();
+	}
+	logObject("setProperties", properties);
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSNumber *b = dict ? OSDynamicCast(OSNumber, dict->getObject("brightness")) : NULL;
+	if (b) {
+		unsigned v = b->unsigned32BitValue();
+		applyBrightness(v);
+		fFromIOS = true;
+		if (v) { /* 0 is the display going off, not a setting */
+			fSaved = v > 1024u ? 1024u : v;
+			fDirty = true;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &fChangedNs);
+		}
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleARMBacklight::message(UInt32 type, IOService *provider, void *argument)
+{
+	if (fLines < 600) {
+		++fLines;
+		IOLog("SURYA BACKLIGHT: message %#x from %s arg %p\n", (unsigned)type,
+		    provider ? provider->getName() : "-", argument);
+	}
+	return kIOReturnSuccess;
+}
