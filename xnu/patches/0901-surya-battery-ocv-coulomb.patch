+/*
+ * surya vibrator: the IOKit vibrator iOS's FigVibrator uses when there is no
+ * "Actuator" audio device (MediaExperience FigVibrator_IOKit.c, read 21.10).
+ * It finds the service with IOServiceNameMatching("vibrator") and calls
+ * IORegistryEntrySetCFProperties with
+ *   {hertz_millisecs: [state, ms, state, ms, ...], repeat: bool},
+ * a state being {intensity: SInt32 16.16} (on) or false (off); a CFNumber 0
+ * instead of the dictionary stops it. On an iPhone this is an
+ * AppleARMPWMDevice, the only class mediaserverd's sandbox lets it set these
+ * keys on; this kernel's sandbox policy is permissive. The motor itself is
+ * the AW8624 in bsd/dev/sweet_touch.c (surya_vib_play).
+ */
+#define SURYA_VIB_MAX_PAIRS 64u
+
+extern "C" int surya_vib_play(const uint32_t *pairs, unsigned n, int repeat);
+
+class SuryaVibrator : public IOService {
+	OSDeclareDefaultStructors(SuryaVibrator);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+private:
+	unsigned fLines;
+};
+OSDefineMetaClassAndStructors(SuryaVibrator, IOService);
+
+bool
+SuryaVibrator::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fLines = 0;
+	setName("vibrator");
+	registerService();
+	IOLog("SURYA VIB: \"vibrator\" service registered\n");
+	return true;
+}
+
+IOReturn
+SuryaVibrator::setProperties(OSObject *properties)
+{
+	if (fLines < 300) {
+		++fLines;
+		OSSerialize *s = OSSerialize::withCapacity(512);
+		if (s && properties && properties->serialize(s)) {
+			IOLog("SURYA VIB: setProperties %.900s\n", s->text());
+		} else {
+			IOLog("SURYA VIB: setProperties (not serializable)\n");
+		}
+		OSSafeReleaseNULL(s);
+	}
+	if (OSDynamicCast(OSNumber, properties)) {
+		return surya_vib_play(NULL, 0, 0) ? kIOReturnNotReady : kIOReturnSuccess;
+	}
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSArray *hm = dict ? OSDynamicCast(OSArray, dict->getObject("hertz_millisecs")) : NULL;
+	if (!hm) {
+		return kIOReturnBadArgument;
+	}
+	OSBoolean *repeat = OSDynamicCast(OSBoolean, dict->getObject("repeat"));
+	uint32_t pairs[2 * SURYA_VIB_MAX_PAIRS];
+	unsigned n = 0;
+	for (unsigned i = 0; i + 1 < hm->getCount() && n < SURYA_VIB_MAX_PAIRS; i += 2, ++n) {
+		OSObject *state = hm->getObject(i);
+		OSNumber *ms = OSDynamicCast(OSNumber, hm->getObject(i + 1));
+		uint32_t intensity = 0;
+		if (OSDictionary *d = OSDynamicCast(OSDictionary, state)) {
+			OSNumber *in = OSDynamicCast(OSNumber, d->getObject("intensity"));
+			int32_t v = in ? (int32_t)in->unsigned32BitValue() : 0x10000;
+			intensity = v > 0 ? (uint32_t)v : 0;
+		} else if (OSBoolean *b = OSDynamicCast(OSBoolean, state)) {
+			intensity = b->isTrue() ? 0x10000u : 0;
+		} else if (OSNumber *v = OSDynamicCast(OSNumber, state)) {
+			intensity = v->unsigned32BitValue(); /* not seen from iOS; read as 16.16 */
+		}
+		pairs[2 * n] = intensity;
+		pairs[2 * n + 1] = ms ? ms->unsigned32BitValue() : 0;
+	}
+	if (hm->getCount() > 2 * SURYA_VIB_MAX_PAIRS) {
+		IOLog("SURYA VIB: pattern of %u entries cut to %u pairs\n", hm->getCount(),
+		    SURYA_VIB_MAX_PAIRS);
+	}
+	return surya_vib_play(pairs, n, repeat && repeat->isTrue()) ?
+	       kIOReturnNotReady : kIOReturnSuccess;
+}
