+IOReturn
+AppleARMBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    IOUserClient **handler)
+{
+	(void)owningTask;
+	(void)securityID;
+	(void)handler;
+	IOLog("SURYA BACKLIGHT: newUserClient type %u refused\n", (unsigned)type);
+	return kIOReturnUnsupported;
+}
