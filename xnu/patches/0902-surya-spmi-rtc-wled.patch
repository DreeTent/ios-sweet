-	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	bool sid0 = sid == 0 &&
+	    (peripheral == 0x10 || peripheral == 0x11 || peripheral == 0x12 ||
+	    peripheral == 0x13 || peripheral == 0x48 ||
+	    peripheral == 0x60); /* 0x60: PM6150 RTC_RW, read by surya's battery log */
+	/* surya: PM6150L WLED5 control and sink on SID 5, for the backlight. */
+	bool sid5 = sid == 5 && (peripheral == 0xd8 || peripheral == 0xd9);
+	if (!sp_ready || !out || addr > 0xffffu || (!sid0 && !sid5)) {
 		return -1;
 	}
