+/* The L11C rail: voltage, HPM mode (raw 7, as this PMIC5 LDO supports), enable last. */
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	const uint32_t addrs[3] = {address, address + 8, address + 4};
+	const uint32_t datas[3] = {mv, 7, 1};
+	printf("SWEET RPMH: L11C %u mV mode=7 enable=1\n", mv);
+	return rh_send_cmds(addrs, datas, 3, "L11C");
+}
+
+/*
+ * surya: Linux bcm-voter's tcs_cmd_gen for n BCMs in one TCS:
+ * data = commit << 30 | valid << 29 | vote_x << 14 | vote_y (14-bit votes,
+ * clamped as bcm-voter clamps them). commit on every command: each BCM here
+ * may be its own voltage control domain.
+ */
+int
+sweet_rpmh_bcm_vote(const char *const *names, unsigned n, uint32_t vote_x, uint32_t vote_y)
+{
+	uint32_t addrs[3], datas[3];
+	if (!names || n == 0 || n > 3) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	for (unsigned k = 0; k < n && !error; ++k) {
+		error = rh_lookup(names[k], RH_BCM, &addrs[k]);
+		uint32_t x = vote_x > 0x3fffu ? 0x3fffu : vote_x, y = vote_y > 0x3fffu ? 0x3fffu : vote_y;
+		datas[k] = (1u << 30) | ((x || y) ? (1u << 29) : 0u) | (x << 14) | y;
+	}
+	if (!error) {
+		error = rh_send_cmds(addrs, datas, n, "BCM");
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: BCM vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
